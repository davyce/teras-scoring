# Configuration TERAS Frontend - Environnement Local
# Pour Vite, toutes les variables doivent commencer par VITE_

# URL de l'API Backend Django
VITE_API_URL=http://127.0.0.1:8000/api

# Alternative avec localhost (identique)
# VITE_API_URL=http://localhost:8000/api

# Notes importantes :
# 1. Le nom VITE_API_URL (pas VITE_API_BASE) doit correspondre à ce qui est utilisé dans les fichiers services
# 2. L'URL doit inclure /api à la fin
# 3. Redémarrer npm run dev après modification de ce fichier
