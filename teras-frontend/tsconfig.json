{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/pages/_legacy",
    "src/components/enterprise/EnterpriseSidebar 2.tsx",
    "src/components/enterprise/EnterpriseSidebar 3.tsx",
    "src/layouts/BankLayout 2.tsx",
    "src/components/enterprise/PendingValidationEnterprise 2.tsx",
    "src/services/services_api 2.ts",
    "src/pages/user/UserCredit.tsx",
    "src/pages/user/UserHelp.tsx",
    "src/services/api.ts",
    "src/services/authFetch.ts",
    "src/services/services_api.ts",
    "src/utils/api.ts",
    "src/utils/auth.ts",
    "src/utils/profileApi.ts"
  ]
}