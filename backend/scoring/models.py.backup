# backend/scoring/models.py
"""
Modèles pour le module scoring TERAS
VERSION FINALE - Compatible avec tout ton code existant
"""

from django.db import models
from django.conf import settings
from django.utils import timezone
from django.core.validators import MinValueValidator, MaxValueValidator


# ============================================================
# MODÈLES EXISTANTS (GARDE-LES !)
# ============================================================

class CreditScore(models.Model):
    """
    Score de crédit principal (ANCIEN MODÈLE)
    Utilisé par views_teras.py et ton code existant
    """
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        null=True,
        blank=True,
        on_delete=models.SET_NULL,
        related_name="credit_scores"
    )
    score = models.FloatField(default=0.0)
    created_at = models.DateTimeField(auto_now_add=True)
    updated_at = models.DateTimeField(auto_now=True)

    class Meta:
        ordering = ["-created_at"]

    def __str__(self):
        return f"{self.user} - {self.score}"


class ScoreHistory(models.Model):
    """
    Historique détaillé des scores TERAS (ANCIEN MODÈLE)
    Utilisé par ComputeScoreView
    """
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        null=True,
        blank=True,
        on_delete=models.SET_NULL,
        related_name="score_history"
    )

    # Données d'entrée
    transactions = models.FloatField(default=0)
    epargne = models.FloatField(default=0)
    revenus = models.FloatField(default=0)
    actifs = models.FloatField(default=0)
    social = models.FloatField(default=0)

    # Résultats
    score = models.FloatField(default=0)
    score_total = models.FloatField(default=0)  # Alias pour compatibilité
    profile_type = models.CharField(max_length=50, default="basic")

    # Détails JSON
    breakdown = models.JSONField(default=dict, blank=True)
    detail = models.JSONField(default=dict, blank=True)  # Ancien nom
    raw_data = models.JSONField(default=dict, blank=True)

    created_at = models.DateTimeField(auto_now_add=True)

    class Meta:
        ordering = ["-created_at"]
        verbose_name_plural = "Score histories"

    def __str__(self):
        return f"{self.user} - {self.score} - {self.created_at.strftime('%Y-%m-%d')}"

    def save(self, *args, **kwargs):
        # Synchroniser score et score_total
        if self.score and not self.score_total:
            self.score_total = self.score
        if self.score_total and not self.score:
            self.score = self.score_total
        super().save(*args, **kwargs)


# ============================================================
# NOUVEAUX MODÈLES TERAS (INTERFACE USER)
# ============================================================

class TerasScore(models.Model):
    """
    Score TERAS principal (NOUVEAU MODÈLE)
    Utilisé par views_user.py - Interface User
    Score complet avec 5 piliers T.E.R.A.S (0-1000 points)
    """
    
    BAND_CHOICES = [
        ('A', 'Excellent (900-1000)'),
        ('B', 'Très bon (750-899)'),
        ('C', 'Bon (600-749)'),
        ('D', 'Moyen (400-599)'),
        ('E', 'Faible (0-399)'),
    ]
    
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.CASCADE,
        related_name='teras_scores',
        verbose_name="Utilisateur"
    )
    
    score_id = models.CharField(
        max_length=100,
        unique=True,
        editable=False,
        verbose_name="ID Score"
    )
    
    score = models.IntegerField(
        validators=[MinValueValidator(0), MaxValueValidator(1000)],
        verbose_name="Score Total"
    )
    
    band = models.CharField(
        max_length=1,
        choices=BAND_CHOICES,
        verbose_name="Bande"
    )
    
    # Détails des 5 piliers (normalisés 0-1)
    T = models.FloatField(
        default=0,
        validators=[MinValueValidator(0), MaxValueValidator(1)],
        verbose_name="Transactions (T)"
    )
    E = models.FloatField(
        default=0,
        validators=[MinValueValidator(0), MaxValueValidator(1)],
        verbose_name="Épargne (E)"
    )
    R = models.FloatField(
        default=0,
        validators=[MinValueValidator(0), MaxValueValidator(1)],
        verbose_name="Revenus (R)"
    )
    A = models.FloatField(
        default=0,
        validators=[MinValueValidator(0), MaxValueValidator(1)],
        verbose_name="Actifs (A)"
    )
    S = models.FloatField(
        default=0,
        validators=[MinValueValidator(0), MaxValueValidator(1)],
        verbose_name="Social (S)"
    )
    
    model_version = models.CharField(
        max_length=20,
        default='basic-1.0.0',
        verbose_name="Version du modèle"
    )
    
    computed_at = models.DateTimeField(
        auto_now_add=True,
        verbose_name="Date de calcul"
    )
    
    reason_codes = models.JSONField(
        default=list,
        blank=True,
        verbose_name="Codes de raison"
    )
    
    raw_data = models.JSONField(
        default=dict,
        blank=True,
        verbose_name="Données brutes"
    )
    
    class Meta:
        verbose_name = "Score TERAS"
        verbose_name_plural = "Scores TERAS"
        ordering = ['-computed_at']
        indexes = [
            models.Index(fields=['user', '-computed_at']),
            models.Index(fields=['band']),
            models.Index(fields=['score']),
        ]
    
    def __str__(self):
        return f"{self.user.email} - {self.score} ({self.band}) - {self.computed_at.strftime('%Y-%m-%d')}"
    
    def save(self, *args, **kwargs):
        # Générer score_id si absent
        if not self.score_id:
            import uuid
            self.score_id = f"scr_{uuid.uuid4().hex[:12]}"
        
        # Calculer la bande automatiquement
        if self.score >= 900:
            self.band = 'A'
        elif self.score >= 750:
            self.band = 'B'
        elif self.score >= 600:
            self.band = 'C'
        elif self.score >= 400:
            self.band = 'D'
        else:
            self.band = 'E'
        
        super().save(*args, **kwargs)
    
    @property
    def level_name(self):
        """Retourne le nom du niveau"""
        levels = {
            'A': 'Platine',
            'B': 'Or',
            'C': 'Argent',
            'D': 'Bronze',
            'E': 'Débutant'
        }
        return levels.get(self.band, 'Inconnu')
    
    @property
    def level_color(self):
        """Retourne la couleur du niveau"""
        colors = {
            'A': '#E5E4E2',  # Platine
            'B': '#FFD700',  # Or
            'C': '#C0C0C0',  # Argent
            'D': '#CD7F32',  # Bronze
            'E': '#808080'   # Gris
        }
        return colors.get(self.band, '#808080')


class Transaction(models.Model):
    """Transactions financières (Pilier T)"""
    
    TYPE_CHOICES = [
        ('credit', 'Crédit'),
        ('debit', 'Débit'),
    ]
    
    STATUS_CHOICES = [
        ('completed', 'Complétée'),
        ('pending', 'En attente'),
        ('failed', 'Échouée'),
        ('cancelled', 'Annulée'),
    ]
    
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.CASCADE,
        related_name='transactions',
        verbose_name="Utilisateur"
    )
    
    tx_type = models.CharField(
        max_length=10,
        choices=TYPE_CHOICES,
        verbose_name="Type"
    )
    
    amount = models.DecimalField(
        max_digits=12,
        decimal_places=2,
        verbose_name="Montant"
    )
    
    currency = models.CharField(
        max_length=3,
        default='XAF',
        verbose_name="Devise"
    )
    
    description = models.CharField(
        max_length=255,
        blank=True,
        verbose_name="Description"
    )
    
    channel = models.CharField(
        max_length=50,
        blank=True,
        verbose_name="Canal"
    )
    
    status = models.CharField(
        max_length=20,
        choices=STATUS_CHOICES,
        default='completed',
        verbose_name="Statut"
    )
    
    created_at = models.DateTimeField(
        auto_now_add=True,
        verbose_name="Date"
    )
    
    class Meta:
        verbose_name = "Transaction"
        verbose_name_plural = "Transactions"
        ordering = ['-created_at']
        indexes = [
            models.Index(fields=['user', '-created_at']),
        ]
    
    def __str__(self):
        return f"{self.amount} {self.currency} - {self.created_at.strftime('%Y-%m-%d')}"


class Income(models.Model):
    """Sources de revenus (Pilier R)"""
    
    SOURCE_CHOICES = [
        ('salary', 'Salaire'),
        ('business', 'Activité commerciale'),
        ('rental', 'Revenus locatifs'),
        ('investment', 'Investissements'),
        ('pension', 'Pension'),
        ('other', 'Autre'),
    ]
    
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.CASCADE,
        related_name='incomes',
        verbose_name="Utilisateur"
    )
    
    source = models.CharField(
        max_length=50,
        choices=SOURCE_CHOICES,
        verbose_name="Source"
    )
    
    monthly_amount = models.DecimalField(
        max_digits=12,
        decimal_places=2,
        verbose_name="Montant mensuel"
    )
    
    verified = models.BooleanField(
        default=False,
        verbose_name="Vérifié"
    )
    
    verified_at = models.DateTimeField(
        null=True,
        blank=True,
        verbose_name="Date vérification"
    )
    
    created_at = models.DateTimeField(
        auto_now_add=True,
        verbose_name="Date création"
    )
    
    class Meta:
        verbose_name = "Revenu"
        verbose_name_plural = "Revenus"
        ordering = ['-created_at']
    
    def __str__(self):
        return f"{self.get_source_display()} - {self.monthly_amount}"


class Asset(models.Model):
    """Actifs/Biens (Pilier A)"""
    
    TYPE_CHOICES = [
        ('real_estate', 'Immobilier'),
        ('vehicle', 'Véhicule'),
        ('equipment', 'Équipement'),
        ('investment', 'Investissement'),
        ('crypto', 'Crypto-monnaie'),
        ('other', 'Autre'),
    ]
    
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.CASCADE,
        related_name='assets',
        verbose_name="Utilisateur"
    )
    
    asset_type = models.CharField(
        max_length=50,
        choices=TYPE_CHOICES,
        verbose_name="Type"
    )
    
    declared_value = models.DecimalField(
        max_digits=15,
        decimal_places=2,
        verbose_name="Valeur déclarée"
    )
    
    verified_value = models.DecimalField(
        max_digits=15,
        decimal_places=2,
        null=True,
        blank=True,
        verbose_name="Valeur vérifiée"
    )
    
    description = models.TextField(
        blank=True,
        verbose_name="Description"
    )
    
    verified = models.BooleanField(
        default=False,
        verbose_name="Vérifié"
    )
    
    created_at = models.DateTimeField(
        auto_now_add=True
    )
    
    class Meta:
        verbose_name = "Actif"
        verbose_name_plural = "Actifs"
        ordering = ['-created_at']
    
    def __str__(self):
        return f"{self.get_asset_type_display()} - {self.declared_value}"
    
    @property
    def risk_coefficient(self):
        """Coefficient de risque"""
        coefficients = {
            'real_estate': 0.9,
            'vehicle': 0.6,
            'equipment': 0.5,
            'investment': 0.7,
            'crypto': 0.2,
            'other': 0.3,
        }
        return coefficients.get(self.asset_type, 0.5)


class Recommendation(models.Model):
    """Recommandations IA personnalisées"""
    
    CATEGORY_CHOICES = [
        ('transactions', 'Transactions'),
        ('epargne', 'Épargne'),
        ('revenus', 'Revenus'),
        ('actifs', 'Actifs'),
        ('social', 'Social'),
        ('general', 'Général'),
    ]
    
    PRIORITY_CHOICES = [
        ('high', 'Haute'),
        ('medium', 'Moyenne'),
        ('low', 'Basse'),
    ]
    
    user = models.ForeignKey(
        settings.AUTH_USER_MODEL,
        on_delete=models.CASCADE,
        related_name='recommendations',
        verbose_name="Utilisateur"
    )
    
    title = models.CharField(
        max_length=200,
        verbose_name="Titre"
    )
    
    description = models.TextField(
        verbose_name="Description"
    )
    
    category = models.CharField(
        max_length=50,
        choices=CATEGORY_CHOICES,
        verbose_name="Catégorie"
    )
    
    priority = models.CharField(
        max_length=20,
        choices=PRIORITY_CHOICES,
        default='medium',
        verbose_name="Priorité"
    )
    
    impact = models.CharField(
        max_length=100,
        blank=True,
        verbose_name="Impact",
        help_text="Ex: +15 points"
    )
    
    is_completed = models.BooleanField(
        default=False,
        verbose_name="Complétée"
    )
    
    completed_at = models.DateTimeField(
        null=True,
        blank=True,
        verbose_name="Date complétion"
    )
    
    created_at = models.DateTimeField(
        auto_now_add=True
    )
    
    class Meta:
        verbose_name = "Recommandation"
        verbose_name_plural = "Recommandations"
        ordering = ['-priority', '-created_at']
    
    def __str__(self):
        status = "✓" if self.is_completed else "○"
        return f"{status} {self.title}"
